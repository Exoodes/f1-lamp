# The main task is the render loop: the controller, serialising the snapshot
# to JSON and logging it. The default 3 KB is too small for that, and 8 KB
# had only 488 B left at its lowest (2026-10-15).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Above their defaults, as in esp-idf-template; never measured lower.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# Threads spawned without a stack size: only small helpers (the restart
# after an update, crash-test). The firmware's own threads set theirs, see
# `config::stack` in src/config.rs.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# A firmware that arrives over WiFi and restarts before it has counted its
# trial boot (`ota::check_boot`) goes straight back to the previous one.
# Takes effect with the bootloader, which only a USB flash writes.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The WebSocket upgrade request is built in this buffer; the default 1 KB
# can't hold `Authorization: Bearer <F1TV token>` (the token alone is 1-2 KB).
CONFIG_WS_BUFFER_SIZE=4096

# mbedTLS keeps a 16 KB receive and a 4 KB send buffer for as long as a TLS
# connection is open; the live feed's WebSocket stays open all session. With
# dynamic buffers they exist only while data moves, and the handshake's
# certificates and keys are freed once it's done: 10-20 KB more free heap
# while connected, so an HTTPS request (calendar, winner) still fits.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# The longest request header the web server takes; longer ones get 431. The
# default 512 B is too tight: the page's POSTs send ~400-450 B (more with a
# long Referer or User-Agent), and a 500 B header was already refused. The
# server keeps one buffer of this size.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# The XIAO ESP32-C3 has 4 MB of flash, and partitions.csv uses nearly all of
# it (the second app slot ends at 0x3F0000, otadata at 0x3F2000).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The partition table stays at ESP-IDF's default (single app) here on
# purpose; nothing reads that setting. espflash (the cargo runner) and
# ota.ps1 get partitions.csv themselves, and the bootloader and the OTA code
# read the table from flash. Pointing CONFIG_PARTITION_TABLE_CUSTOM_FILENAME
# at partitions.csv would need a path relative to esp-idf-sys's build folder
# deep in target/, which moves with cargo's layout.
